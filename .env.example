# ==============================================================================
# Krishna AI — Meta Global AI Developer Hackathon Configuration
# ==============================================================================

# --- Gateway & Inference API --------------------------------------------------
KRSNA_LLM_API_KEY=your_api_key_here
KRSNA_LLM_BASE_URL=http://127.0.0.1:4000/v1

# --- Meta Open-Weights Models -------------------------------------------------
# Flagship Depth Model:
# Options:
#  - muse-wonder-1.0 (Meta Official Reasoning & Multimodal)
#  - meta-llama/Llama-3.3-70B-Instruct (High-precision flagship)
#  - meta-llama/Llama-3.1-70B-Instruct
KRSNA_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Fast First-Turn Model (Low latency):
# Options:
#  - muse-spark-1.3 (Meta Official Fast Reasoning)
#  - meta-llama/Llama-3.1-8B-Instruct (Ultra-fast ~1s response)
KRSNA_FAST_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Fallback Model:
KRSNA_CHAT_FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Embedding Model:
KRSNA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# --- Latency & Token Budget Tuning -------------------------------------------
# Enables fast 1st turn (~120-160 words + clarifying inquiry)
KRSNA_FAST_FIRST_TURN=1
KRSNA_FAST_MAX_TOKENS=450
KRSNA_MAX_TOKENS=1200

# Fast embedding network failover (seconds before falling back to instant lexical retrieval):
KRSNA_EMBED_TIMEOUT=2.5
