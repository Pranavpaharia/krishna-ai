# Copy to .env and fill in your values. .env is never committed.
KRSNA_LLM_API_KEY=
KRSNA_LLM_BASE_URL=http://192.168.0.60:4000/v1
# Meta Muse models (muse-wonder-1.0 / muse-spark-1.3) currently 402 upstream (billing),
# so the default here is the local cluster: LightFury primary, Groq cloud fallback.
KRSNA_CHAT_MODEL=LightFury
KRSNA_CHAT_FALLBACK_MODEL=Groq (Qwen3.8-27B)
KRSNA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
